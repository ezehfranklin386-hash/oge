# Brevo HTTP API — server-side secrets for the notify-lead Edge Function.
# The function sends via https://api.brevo.com/v3/smtp/email (api-key header).
#
# IMPORTANT: never put Brevo credentials in frontend/.env. VITE_* vars are compiled
# into the public browser bundle — anyone visiting the site could steal them.
#
# For the deployed function, set these same names in:
#   Supabase Dashboard → Project Settings → Edge Functions → Secrets

# Required — Brevo API key (starts with xkeysib-...).
BREVO_API_KEY=<your brevo api key>

# Required — must be a sender email verified in your Brevo account
# (Settings → Senders). Email-level verification only — no domain/DNS needed.
BREVO_SENDER_EMAIL=<your verified sender email>

# Optional — the "From" name clients see in their inbox.
BREVO_SENDER_NAME=G Interior
