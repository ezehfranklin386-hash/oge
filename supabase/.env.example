# Brevo (formerly Sendinblue) — server-side secrets for the notify-lead Edge Function.
# Get your API key: Brevo Dashboard → SMTP & API → API Keys → Generate API Key
#
# IMPORTANT: never put the Brevo key in frontend/.env. VITE_* vars are compiled
# into the public browser bundle — anyone visiting the site could steal the key.
#
# For the deployed function, set these same names in:
#   Supabase Dashboard → Project Settings → Edge Functions → Secrets

# Required — the API key that authorizes sending via Brevo.
BREVO_API_KEY=xkeysib-<your key here>

# Required — must be a sender email verified in your Brevo account
# (Settings → Senders → verify a domain, or use the default onboarding sender).
BREVO_SENDER_EMAIL=your-sender@example.com

# Optional — the "From" name clients see in their inbox.
BREVO_SENDER_NAME=G Interior
